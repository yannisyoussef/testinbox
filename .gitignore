# IDE
.idea/
*.iml

# OS
.DS_Store

# Node
node_modules/

# Build output (also keeps working-tree scanners off generated artifacts)
build/
dist/
.next/
.gradle/
test-results/
playwright-report/

# Long-form task prompts handed to agents; not part of the product
prompts/

# Agent instruction files generated by `next dev` (Next 16 writes these via
# generate-agent-files.js on every run, and re-creates them if deleted). They
# are tool output, not repository instructions, and the copy Next writes even
# argues for committing itself — which is exactly why it is ignored here rather
# than trusted.
web/AGENTS.md
web/CLAUDE.md

# Deployment environment files. Only .env.example (names, never values) is
# committed; a real .env holds staging credentials.
.env
.env.*
!.env.example
deploy/**/tls/
# The staging rehearsal writes a throwaway CA and server key here.
.rehearsal/
