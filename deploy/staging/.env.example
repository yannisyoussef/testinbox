# Staging environment configuration. NAMES ONLY — this file never holds a
# value that is a secret, and a real .env is never committed (see .gitignore).
# On a deployment host the real values come from the host's secret store or
# from the GitHub `staging` environment; see docs/dev/staging.md.

# --- artifacts (ADR-028): digests, never tags -------------------------------
TESTINBOX_API_IMAGE=ghcr.io/yannisyoussef/testinbox-api@sha256:REPLACE
TESTINBOX_INGESTION_IMAGE=ghcr.io/yannisyoussef/testinbox-ingestion@sha256:REPLACE
TESTINBOX_WEB_IMAGE=ghcr.io/yannisyoussef/testinbox-web@sha256:REPLACE
TESTINBOX_MIGRATOR_IMAGE=ghcr.io/yannisyoussef/testinbox-migrator@sha256:REPLACE
TESTINBOX_GIT_SHA=REPLACE

# --- identity ---------------------------------------------------------------
TESTINBOX_ENVIRONMENT=staging
TESTINBOX_SERVER_NAME=staging.testinbox.email
TESTINBOX_PUBLIC_BASE_URL=https://staging.testinbox.email
TESTINBOX_MAIL_DOMAIN=staging.testinbox.email

# --- data services ----------------------------------------------------------
# true  → PostgreSQL and MinIO run from compose.data.yaml on this host
# false → managed services; point the URL/endpoint at them instead
TESTINBOX_BUNDLED_DATA=true
TESTINBOX_DB_NAME=testinbox
# NOTE: a session-scoped connection. Never a transaction-mode pooler (ADR-020,
# ADR-030 capability 2) — LISTEN is accepted there and then never delivers.
TESTINBOX_DB_URL=jdbc:postgresql://postgres:5432/testinbox
TESTINBOX_DB_USER=REPLACE
TESTINBOX_DB_PASSWORD=REPLACE
TESTINBOX_S3_ENDPOINT=http://minio:9000
TESTINBOX_S3_ACCESS_KEY=REPLACE
TESTINBOX_S3_SECRET_KEY=REPLACE
TESTINBOX_S3_BUCKET=testinbox-mime

# --- synthetic verification credential --------------------------------------
# Dedicated to the post-deployment synthetic test. Never a personal or admin
# key; at least 32 characters or the applications refuse to start.
TESTINBOX_BOOTSTRAP_API_KEY=REPLACE

# --- long-poll timeout relationship (ADR-020, §13) --------------------------
# The edge read timeout must exceed the server wait window by a real margin, or
# a legitimate full-window wait becomes a 504. Both sides read this pair, and
# DeploymentSafety refuses to start if they are inconsistent.
TESTINBOX_WAIT_WINDOW_CAP=60s
TESTINBOX_PROXY_READ_TIMEOUT_SECONDS=120
# Set this to the ingress's hard per-request ceiling where it has one, and the
# applications refuse to start with a wait window that cannot fit underneath.
# On the Infinity staging path that is Cloudflare's ~100s; leave it unset for
# the nginx reference topology, which imposes no ceiling of its own.
# TESTINBOX_EDGE_REQUEST_CEILING=100s

# --- edge protection (§12): infrastructure ceilings, not tenant policy -------
# Sized ABOVE the summed ADR-027 workspace budgets (~27 r/s sustained, ~840
# burst), because the tenant limiter is the product control and must refuse
# first. The edge is a blast-radius ceiling for unauthenticated traffic.
TESTINBOX_EDGE_RATE_PER_SECOND=200
TESTINBOX_EDGE_BURST=1000
TESTINBOX_EDGE_CONN_LIMIT=256

# --- network exposure (§10) -------------------------------------------------
TESTINBOX_TLS_DIR=/etc/testinbox/tls
TESTINBOX_HTTP_BIND=0.0.0.0
TESTINBOX_HTTPS_BIND=0.0.0.0
TESTINBOX_HTTP_PUBLISHED_PORT=80
TESTINBOX_HTTPS_PUBLISHED_PORT=443
# SMTP is NOT public. Bind it to a private interface and restrict with the host
# firewall; the synthetic test reaches it over that private path.
TESTINBOX_SMTP_BIND=127.0.0.1
TESTINBOX_SMTP_PUBLISHED_PORT=2525
