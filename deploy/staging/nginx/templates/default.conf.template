# TestInbox staging edge (TI-DEPLOY-001 §12/§13).
#
# Rendered by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf — deliberately that name, so it REPLACES the
# image's stock vhost rather than sitting alongside it.
#
# Two jobs, and they are different jobs:
#
#  1. Infrastructure safety — body/header size caps, connection and request
#     ceilings, slow-client timeouts. These bound what an *unauthenticated*
#     caller can cost us before the application ever sees the request. They
#     are NOT the tenant policy of ADR-027: that keys on the authenticated
#     workspace and lives in the application layer, where it also protects the
#     ingestion gateway. Duplicating tenant policy here would cover only the
#     API, and would drift from the copy that matters.
#
#  2. Not breaking `waitForMessage`. TestInbox answers a bounded long poll
#     with `200 {status: TIMEOUT}` (ADR-012/020). nginx's *default*
#     proxy_read_timeout is 60s — exactly the server's wait-window cap — so a
#     stock configuration races every full-window wait and turns a legitimate
#     answer into a 504. The value below comes from the same environment
#     variable the applications validate their wait window against
#     (DeploymentSafety), so the two cannot drift apart silently.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Per-IP budgets. `$binary_remote_addr` because it is 4/16 bytes rather than a
# string; 10m holds roughly 160k addresses.
limit_req_zone  $binary_remote_addr zone=testinbox_edge:10m rate=${TESTINBOX_EDGE_RATE_PER_SECOND}r/s;
limit_conn_zone $binary_remote_addr zone=testinbox_conn:10m;

# 429 rather than 503: a refusal here is "too many requests", and sharing the
# status with the tenant limiter keeps clients on one retry path.
limit_req_status  429;
limit_conn_status 429;

server_tokens off;
client_header_buffer_size 4k;

# An unmatched Host must not fall through into the TestInbox vhost.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${TESTINBOX_SERVER_NAME};

    # ACME HTTP-01 stays plaintext; everything else is redirected.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${TESTINBOX_SERVER_NAME};

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:TestInboxTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Safe because port 80 only ever redirects.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Nothing in the v1 contract accepts a large body: inbound mail arrives
    # over SMTP, not over HTTP.
    client_max_body_size        256k;
    client_body_buffer_size     64k;
    large_client_header_buffers 4 8k;

    # Slow-client protection: dribbling a request must not hold a worker.
    client_header_timeout 15s;
    client_body_timeout   15s;
    send_timeout          30s;
    keepalive_timeout     75s;

    limit_conn testinbox_conn ${TESTINBOX_EDGE_CONN_LIMIT};

    # Actuator lives on a private management port and is never routed here.
    # This location is belt-and-braces: if an upstream change ever put it back
    # on the traffic port, the edge still would not serve it.
    location /actuator { return 404; }

    location /v1/ {
        limit_req zone=testinbox_edge burst=${TESTINBOX_EDGE_BURST} nodelay;

        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        # THE long-poll setting — see the header comment.
        proxy_read_timeout    ${TESTINBOX_PROXY_READ_TIMEOUT_SECONDS}s;
        proxy_buffering       on;
    }

    location / {
        limit_req zone=testinbox_edge burst=${TESTINBOX_EDGE_BURST} nodelay;

        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
