# TestInbox staging edge (TI-DEPLOY-001 §12/§13).
#
# Rendered by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf — deliberately that name, so it REPLACES the
# image's stock vhost rather than sitting alongside it.
#
# Three jobs, and they are different jobs:
#
#  1. Infrastructure safety — body/header size caps, connection and request
#     ceilings, slow-client timeouts. These bound what an *unauthenticated*
#     caller can cost us before the application ever sees the request. They
#     are NOT the tenant policy of ADR-027: that keys on the authenticated
#     workspace and lives in the application layer, where it also protects the
#     ingestion gateway. Crucially the ceilings here must sit ABOVE the
#     workspace budgets (see the zone comments), or the edge refuses traffic
#     the product promises to serve and the tenant limiter never fires.
#
#  2. Not breaking `waitForMessage`. TestInbox answers a bounded long poll
#     with `200 {status: TIMEOUT}` (ADR-012/020). nginx's *default*
#     proxy_read_timeout is 60s — exactly the server's wait-window cap — so a
#     stock configuration races every full-window wait and turns a legitimate
#     answer into a 504. The value below comes from the same environment
#     variable the applications validate their wait window against
#     (DeploymentSafety), so the two cannot drift apart silently.
#
#  3. Surviving a redeploy. See the `resolver` note below — this one is
#     invisible on a first deployment and wrong on every one after it.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Docker's embedded DNS. This is load-bearing, not tidiness.
#
# `proxy_pass http://api:8080` with a literal name is resolved ONCE, when the
# configuration is loaded, and cached for the worker's lifetime. A redeploy
# recreates `api` and `web` with new addresses but leaves `edge` untouched
# (same image, same environment — compose considers it up to date), so nginx
# would keep proxying to the previous containers' addresses. Docker's IPAM can
# even hand `api`'s old address to `web`, which routes `/v1/` to the Next.js
# server. Resolving through a variable defers lookup to request time, and has
# the second benefit that nginx can start before the upstreams exist — which
# matters after a host reboot, where restart policies do not honour
# `depends_on`.
resolver 127.0.0.11 valid=10s ipv6=off;

# Per-IP budgets, in two zones so that loading the UI cannot consume the API's
# allowance.
#
# Sized ABOVE the ADR-027 workspace budgets on purpose. The tenant policy is
# the product control and must be the thing that refuses first; the edge is a
# blast-radius ceiling for traffic that has not authenticated yet. Summed
# workspace budgets are ~27 r/s sustained with ~840 burst (READ 600/20,
# WAIT 120/4, DOWNLOAD 60/2, INBOX_CREATE 60/1), and TestInbox's users are CI
# runners that legitimately arrive in parallel from a single NAT address.
limit_req_zone  $binary_remote_addr zone=testinbox_api:10m rate=${TESTINBOX_EDGE_RATE_PER_SECOND}r/s;
limit_req_zone  $binary_remote_addr zone=testinbox_ui:10m  rate=${TESTINBOX_EDGE_RATE_PER_SECOND}r/s;
limit_conn_zone $binary_remote_addr zone=testinbox_conn:10m;

# 429 rather than 503: a refusal here is "too many requests", and sharing the
# status with the tenant limiter keeps clients on one retry path. That only
# works if the *shape* matches too — see the `error_page` handler below.
limit_req_status  429;
limit_conn_status 429;

server_tokens off;
client_header_buffer_size 4k;

# An unmatched Host must not fall through into the TestInbox vhost.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    # The container's own liveness probe. Deliberately on the default server so
    # it needs no Host header and no certificate trust, and deliberately NOT on
    # the TestInbox vhost, where it would be a public endpoint. It answers only
    # for a Host nobody legitimately sends, and it says nothing but "nginx
    # loaded its configuration and is serving".
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    location / { return 444; }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${TESTINBOX_SERVER_NAME};

    # ACME HTTP-01 stays plaintext; everything else is redirected.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${TESTINBOX_SERVER_NAME};

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:TestInboxTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Nothing in the v1 contract accepts a large body: inbound mail arrives
    # over SMTP, not over HTTP.
    client_max_body_size        256k;
    client_body_buffer_size     64k;
    large_client_header_buffers 4 8k;

    # Slow-client protection: dribbling a request must not hold a worker.
    client_header_timeout 15s;
    client_body_timeout   15s;
    send_timeout          30s;
    keepalive_timeout     75s;

    limit_conn testinbox_conn ${TESTINBOX_EDGE_CONN_LIMIT};

    # `add_header` does NOT accumulate across levels: a location that declares
    # any add_header discards every one inherited from the server block. So the
    # security headers are defined once here and repeated in full by each
    # location that adds to them. Getting this wrong silently drops nosniff and
    # HSTS from the UI — the one origin that renders message-derived content.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Actuator lives on a private management port and is never routed here.
    # This location is belt-and-braces: if an upstream change ever put it back
    # on the traffic port, the edge still would not serve it.
    location /actuator { return 404; }

    # RFC 7807, matching the tenant limiter's shape (docs/api/principles.md).
    # `retryAfterSeconds` is in the BODY as well as the header because that is
    # where the SDKs read it from; a header-only hint reaches no client.
    error_page 429 = @edge_rate_limited;
    location @edge_rate_limited {
        internal;
        default_type "application/problem+json";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Retry-After 1 always;
        add_header Cache-Control "no-store" always;
        return 429 '{"type":"https://testinbox.email/problems/edge-rate-limited","title":"Too many requests","status":429,"detail":"Refused by the edge before reaching the API. This is an infrastructure ceiling, not a workspace limit.","retryAfterSeconds":1}';
    }

    location /v1/ {
        limit_req zone=testinbox_api burst=${TESTINBOX_EDGE_BURST} nodelay;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;

        # Variable upstream so the name is re-resolved per request — see the
        # `resolver` note above. With a variable, nginx no longer appends the
        # request URI automatically, hence the explicit $request_uri.
        set $api_upstream "http://api:8080";
        proxy_pass $api_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Normalise, do not pass through: the applications run
        # `forward-headers-strategy: native` and the compose bridge falls inside
        # Tomcat's trusted internal-proxies, so a client-supplied
        # X-Forwarded-Host would be believed.
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header Forwarded         "";
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        # THE long-poll setting — see the header comment.
        proxy_read_timeout    ${TESTINBOX_PROXY_READ_TIMEOUT_SECONDS}s;
        proxy_buffering       on;
    }

    location / {
        limit_req zone=testinbox_ui burst=${TESTINBOX_EDGE_BURST} nodelay;

        # Repeat the server-level headers (see the add_header note above) and
        # add the UI-only ones. The UI never embeds and is never embedded;
        # untrusted message HTML renders inside a sandboxed srcdoc iframe
        # (ADR-011) and this is the outer belt around it.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;

        set $web_upstream "http://web:3000";
        proxy_pass $web_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header Forwarded         "";
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
